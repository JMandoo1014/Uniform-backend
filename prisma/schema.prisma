generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  RESTRICTED
  WITHDRAWN
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

enum EnrollmentStatus {
  ENROLLED
  LEAVE_OF_ABSENCE
  GRADUATED
  NOT_APPLICABLE
}

enum GradeLevel {
  FRESHMAN
  SOPHOMORE
  JUNIOR
  SENIOR_OR_ABOVE
  GRADUATE
  NOT_APPLICABLE
}

enum MajorField {
  HUMANITIES_SOCIAL
  BUSINESS
  ENGINEERING
  NATURAL_SCIENCE
  MEDICINE
  ARTS_SPORTS
  EDUCATION
  NOT_APPLICABLE
}

enum SurveyOwnerType {
  USER
  TEAM
}

enum SurveyStatus {
  DRAFT
  RECRUITING
  CLOSED
  ARCHIVED
  REMOVED
}

enum SurveyQuestionType {
  SINGLE_CHOICE
  MULTI_CHOICE
  SCALE
  SHORT_ANSWER
  NARRATIVE
  ETC
}

model User {
  id                 String            @id @default(uuid())
  email              String?           @unique
  passwordHash       String
  nickname           String?           @unique
  gender             Gender?
  grade              GradeLevel?
  majorField         MajorField?
  enrollmentStatus   EnrollmentStatus?
  marketingOptIn     Boolean           @default(false)
  status             UserStatus        @default(PENDING_VERIFICATION)
  agreedTermsVersion String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  // Not in the original spec; required to implement POST /auth/verify-email.
  emailVerificationToken          String?   @unique
  emailVerificationTokenExpiresAt DateTime?

  // Not in the original spec; required to implement POST /auth/password/reset-confirm.
  passwordResetToken          String?   @unique
  passwordResetTokenExpiresAt DateTime?

  // Spec 8.1 / 2.3: marketing opt-in changes only need the latest change timestamp.
  marketingOptInChangedAt DateTime?

  statusHistories  UserStatusHistory[]
  profileHistories UserProfileHistory[]
  ledTeams         Team[]               @relation("TeamLeader")
  teamMemberships  TeamMember[]

  @@map("users")
}

// Spec 2.3: "변경 전후 값과 시각을 기록한다" for nickname/profile edits.
model UserProfileHistory {
  id        String   @id @default(uuid())
  userId    String
  field     String
  oldValue  String?
  newValue  String?
  changedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_profile_histories")
}

// Spec 2.5: "탈퇴 이메일을 해시로 보관한다" to block re-signup for 30 days.
model WithdrawnEmail {
  id          String   @id @default(uuid())
  emailHash   String   @unique
  withdrawnAt DateTime @default(now())

  @@map("withdrawn_emails")
}

model UserStatusHistory {
  id        String     @id @default(uuid())
  userId    String
  status    UserStatus
  reason    String?
  changedAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_status_histories")
}

model Team {
  id          String    @id @default(uuid())
  name        String
  leaderId    String
  inviteToken String    @unique @default(uuid())
  createdAt   DateTime  @default(now())
  disbandedAt DateTime?

  leader  User         @relation("TeamLeader", fields: [leaderId], references: [id])
  members TeamMember[]

  @@index([leaderId])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  userId   String
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

// ownerId is polymorphic (points to User.id or Team.id depending on ownerType)
// and intentionally has no Prisma-level foreign key; ownership is resolved in the service layer.
model Survey {
  id          String          @id @default(uuid())
  ownerType   SurveyOwnerType
  ownerId     String
  title       String
  description String?
  status      SurveyStatus    @default(DRAFT)
  targetCount Int?
  deadlineAt  DateTime?
  publishedAt DateTime?
  closedAt    DateTime?
  purgeAt     DateTime?
  version     Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  questions SurveyQuestion[]

  @@index([ownerType, ownerId])
  @@map("surveys")
}

model SurveyQuestion {
  id            String             @id @default(uuid())
  surveyId      String
  orderNo       Int
  stableKey     String
  type          SurveyQuestionType
  questionText  String
  required      Boolean            @default(true)
  minSelect     Int?
  maxSelect     Int?
  minScale      Int?
  maxScale      Int?
  minScaleLabel String?
  maxScaleLabel String?

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  options SurveyOption[]

  @@unique([surveyId, stableKey])
  @@unique([surveyId, orderNo])
  @@map("survey_questions")
}

model SurveyOption {
  id         String  @id @default(uuid())
  questionId String
  orderNo    Int
  label      String
  isEtc      Boolean @default(false)

  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, orderNo])
  @@map("survey_options")
}
