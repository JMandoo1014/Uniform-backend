# 개발 서버(api-dev.uniform-app.com) 템플릿 — ~/Uniform-backend-dev/.env 로 복사해
# 값을 채우고 chmod 600. 운영과 같은 서버·같은 postgres 컨테이너(uniform-postgres)를
# 쓰지만 DB·계정·비밀키는 운영과 완전히 분리한다. 절차: docs/dev-server-runbook.md
#
# ⚠️ 표시가 있는 값은 운영과 반드시 달라야 한다. 운영 .env에서 복사해 오지 말 것.
# 비밀값 생성: openssl rand -hex 32  (hex라 DATABASE_URL에 넣어도 인코딩이 필요 없다)
#
# POSTGRES_USER/PASSWORD/DB는 일부러 넣지 않는다 — 공유 컨테이너는 운영 경로
# (~/Uniform-backend)의 docker-compose.yml로만 관리한다. 이 폴더에서 실수로
# docker compose를 실행해도 값이 없어 바로 멈춘다(${VAR:?}).

# ⚠️ 개발 전용 DB(uniform_staging)와 전용 계정. 운영 DB(uniform_dev)나 운영 계정을
# 넣으면 deploy-dev.sh가 배포를 거부한다. 계정은 이 DB에만 권한이 있다.
DATABASE_URL="postgresql://uniform_staging:change-me-staging-db-password@localhost:5432/uniform_staging?schema=public"

# App
# 개발 서버도 production으로 둔다 — 아니면 개발용 토큰 로그(이메일과 인증·재설정
# 토큰)가 PM2 로그에 남는다. 셸이 아니라 이 파일에만 둘 것.
NODE_ENV=production
# 개발 서버 포트(운영은 3000). 비어 있거나 3001이 아니면 deploy-dev.sh가 거부한다.
PORT=3001
HOST=127.0.0.1

# 개발 프론트(Cloudflare Pages develop 브랜치)만 허용한다.
# 필요하면 쉼표로 추가: 팀원 로컬 Vite(http://localhost:5173), Pages 프리뷰
# (https://*.uni-form-go.pages.dev — 운영 CORS에서 빼고 개발 쪽에서 받는 것을 권장).
CORS_ORIGIN="https://develop.uni-form-go.pages.dev"

# 인증·재설정 메일 링크가 가리키는 프론트 주소.
FRONTEND_URL="https://develop.uni-form-go.pages.dev"

# JWT
# ⚠️ 운영과 다른 값. 같으면 개발 서버에서 발급한 토큰이 운영에서도 서명 검증을
# 통과한다(회원 id가 우연히 같으면 그대로 로그인된다).
JWT_SECRET="change-me-staging-access-secret"
JWT_EXPIRES_IN="30m"
# ⚠️ 운영과 다른 값(위와 같은 이유). JWT_SECRET과도 다르게.
JWT_REFRESH_SECRET="change-me-staging-refresh-secret"
JWT_REFRESH_EXPIRES_IN="7d"

# ⚠️ 운영과 다른 값. 같으면 두 DB의 탈퇴 이메일 해시가 같아져 운영 탈퇴자를 개발
# DB 기준으로 대조할 수 있게 된다. 한 번 정하면 바꾸지 말 것(바꾸면 기존 탈퇴
# 이메일과 대조가 안 된다).
WITHDRAWN_EMAIL_HMAC_SECRET="change-me-staging-hmac-secret"

# 현재 약관 시행일(YYYY-MM-DD). 보통 운영과 같게 두고, 새 약관을 미리 시험할 때만
# 개발에서 먼저 바꾼다(그 날짜로 바꾸면 개발 회원 전원이 재동의 대상이 된다).
TERMS_VERSION="2026-09-01"

EMAIL_VERIFICATION_TOKEN_EXPIRES_IN="24h"
PASSWORD_RESET_TOKEN_EXPIRES_IN="30m"

# 메일(Resend) — 개발 서버도 가입 인증·비밀번호 재설정 메일을 실제로 보낸다.
# 선택지:
#   A) 운영과 같은 키: 가장 간단하지만, 키 하나를 두 곳에 두게 되고 개발 쪽 실수가
#      운영 발송 평판(uniform-app.com 도메인)에 그대로 영향을 준다.
#   B) 개발 전용 키(같은 Resend 계정·같은 발신 도메인, 발송 권한만): 따로 폐기할 수
#      있고 대시보드에서 개발 발송만 구분해 볼 수 있다.
#   C) 끄기: 이 줄을 빼면 앱이 부팅하지 못한다(MailService가 부팅 때 키를 요구).
#      빈 문자열("")이면 부팅은 되지만 모든 발송이 실패해 로그만 남고, 가입 인증
#      메일이 안 가서 새 계정을 쓸 수 없다 — 사실상 선택 불가.
# 의견: B. 테스트는 팀원 본인 메일 주소로만 하고, 실제 회원 주소를 개발 DB에 넣지 않는다.
RESEND_API_KEY="re_your-staging-resend-api-key"

# 개발 서버 문의 접수 알림을 받을 주소. 비우면 문의는 저장만 되고 메일은 안 간다.
ADMIN_NOTIFICATION_EMAIL=""

# FormMate(Gemini) 선택지:
#   A) 운영과 같은 키: 사용량·비용이 섞이고, 개발 쪽에서 키가 새면 운영도 같이 막아야 한다.
#   B) 개발 전용 키(별도 프로젝트): 사용량·비용을 따로 보고 따로 폐기할 수 있다.
#   C) 비워 둠: 앱은 뜨지만 FormMate 요청이 500이 되고 질문 메시지만 DB에 남는다.
# 의견: B. 무료 등급 키는 입력이 모델 개선에 쓰일 수 있으니, 개발에서도 실제 개인정보를
# 넣지 않는다.
GEMINI_API_KEY="your-staging-gemini-api-key"
# 비우면 코드 기본 모델을 쓴다.
# GEMINI_MODEL=""

# 개인정보 정리 배치(매일 04:00 KST)는 개발 서버에서도 개발 DB를 대상으로 돈다.
# 운영과 같은 설정으로 두면 배포 전에 동작을 미리 볼 수 있다.
RETENTION_DRY_RUN="false"
RETENTION_DISABLED_JOBS="survey-purge"
