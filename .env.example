# Postgres container account (docker-compose.yml reads these; required).
# Only used when the data volume is first created — changing them later does
# NOT change an existing DB's password (use ALTER USER for that).
POSTGRES_USER="uniform"
POSTGRES_PASSWORD="uniform"
POSTGRES_DB="uniform_dev"

# PostgreSQL connection string — user/password/db must match the POSTGRES_* above
DATABASE_URL="postgresql://uniform:uniform@localhost:5432/uniform_dev?schema=public"

# App
PORT=3000

# Comma-separated allowed origins for CORS (e.g. frontend dev server). Leave
# unset to allow all origins, which is fine for local dev. An entry containing
# "*" is a wildcard matching one subdomain slot — see .env.production.example
# for the Cloudflare Pages preview-domain use case.
# CORS_ORIGIN="http://localhost:5173"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
# Access token TTL. 30m for dev/test convenience; tighten before production deploy.
JWT_EXPIRES_IN="30m"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"
JWT_REFRESH_EXPIRES_IN="7d"

# Withdrawn-email HMAC key (spec 2.5 re-signup block). Required — the app
# refuses to boot without it. Changing it later stops matching emails withdrawn
# under the old key, so set it once and keep it. Generate: openssl rand -hex 32
WITHDRAWN_EMAIL_HMAC_SECRET="change-me-to-another-long-random-string"

# Email verification token TTL
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN="24h"

# Password reset token TTL
PASSWORD_RESET_TOKEN_EXPIRES_IN="30m"

# Resend SMTP — used to send verification/reset-link emails (get a key from
# resend.com after verifying the sending domain). auth.user is always the
# literal string "resend"; this key is the password.
RESEND_API_KEY="re_your-resend-api-key"

# Base URL of the deployed frontend — verification/reset links are built as
# "{FRONTEND_URL}/verify-email?token=..." and "{FRONTEND_URL}/reset-password?token=...".
FRONTEND_URL="http://localhost:5173"

# Where new /support/inquiries submissions get emailed for the team to see.
# Optional — if unset, inquiries are still saved but no notification is sent.
ADMIN_NOTIFICATION_EMAIL="your-team-inbox@example.com"

# Google Gemini (FormMate) — get a key from Google AI Studio.
GEMINI_API_KEY="your-gemini-api-key"
# Optional — defaults to gemini-3.8-flash if unset. Check ai.google.dev for the
# current fast/flash-tier model name before changing this.
# GEMINI_MODEL="gemini-3.8-flash"

# Daily privacy-retention batch (04:00 KST). "true" = only log how many rows
# each job would delete/scrub, change nothing. Turn on for the first production
# run, check the logs, then remove it.
RETENTION_DRY_RUN="false"

# Comma-separated retention jobs to skip (logged as "disabled"). Names:
#   survey-purge, unverified-accounts, withdrawn-emails, answered-inquiries,
#   admin-log-scrub
RETENTION_DISABLED_JOBS=""
