# docker-compose.prod.yml 전용 템플릿. 실제 값을 채운 사본을 레포 루트에
# ".env"로 저장해서 쓴다(.env는 .gitignore로 커밋 제외됨).
#
# DATABASE_URL의 호스트는 "postgres" 고정 — 컨테이너 간 통신은 서비스 이름으로
# 하므로 localhost가 아니다. 아래 POSTGRES_* 값과 반드시 일치시킬 것(docker-
# compose.prod.yml처럼 .env는 변수 치환을 지원하지 않아 직접 맞춰 적어야 한다).
DATABASE_URL="postgresql://uniform:change-me-to-a-strong-password@postgres:5432/uniform_prod?schema=public"

# postgres 서비스(공식 postgres 이미지)가 그대로 읽는 값 — 위 DATABASE_URL과 일치시킬 것.
POSTGRES_USER="uniform"
POSTGRES_PASSWORD="change-me-to-a-strong-password"
POSTGRES_DB="uniform_prod"

# App
# 필수. Docker 이미지는 Dockerfile에서 NODE_ENV=production을 넣지만, PM2 등으로
# 서버에서 node를 직접 띄우면 이 값이 없을 때 개발용 토큰 로그(이메일과 인증·
# 재설정 토큰)가 운영 로그에 남는다. 셸에 export하지 말고 이 파일에만 둘 것 —
# 셸에 있으면 npm install이 devDependencies를 빼고 설치해 빌드가 깨진다.
NODE_ENV=production
PORT=3000
# 바인딩 주소. 호스트 nginx(deploy/nginx)가 127.0.0.1:PORT로 넘기므로 외부에 직접 열지 않는다.
# 개발 서버는 PORT=3001. docker-compose.prod.yml로 띄울 때는 compose가 HOST=0.0.0.0을 넣는다.
HOST=127.0.0.1

# Comma-separated allowed origins for CORS (e.g. frontend origin(s)). Leave
# unset to allow all origins — for production, set this to the real frontend
# domain(s), same value(s) as FRONTEND_URL below. This is about who is allowed
# to CALL this API (the browser's Origin header) — it is NOT this backend's
# own domain, so changing the backend's own domain/URL (e.g. moving behind a
# new api.* hostname) does not require touching this value.
#
# An entry containing "*" is treated as a wildcard covering exactly one
# subdomain slot (letters/digits/hyphens, no dot) — use this for Cloudflare
# Pages preview deployments, which get a fresh subdomain per branch/commit
# (see src/common/utils/cors-origin.util.ts). Example below allows the
# production domain, a teammate's local Vite dev server, and every Pages
# preview URL:
CORS_ORIGIN="https://your-frontend-domain.example,http://localhost:5173,https://*.your-frontend-domain.example"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
# Access token TTL. 30m for dev/test convenience; tighten before production deploy.
JWT_EXPIRES_IN="30m"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"
JWT_REFRESH_EXPIRES_IN="7d"

# Withdrawn-email HMAC key (spec 2.5 re-signup block). Required — the app
# refuses to boot without it. Changing it later stops matching emails withdrawn
# under the old key, so set it once and keep it. Generate: openssl rand -hex 32
WITHDRAWN_EMAIL_HMAC_SECRET="change-me-to-another-long-random-string"

# Email verification token TTL
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN="24h"

# Password reset token TTL
PASSWORD_RESET_TOKEN_EXPIRES_IN="30m"

# Resend SMTP — get a key from resend.com after verifying the sending domain
# (uniform-app.com). auth.user is always the literal string "resend"; this
# key is the password.
RESEND_API_KEY="re_your-resend-api-key"

# Base URL of the deployed frontend — verification/reset links point here.
FRONTEND_URL="https://your-frontend-domain.example"

# Where new /support/inquiries submissions get emailed for the team to see.
# Optional — if unset, inquiries are still saved but no notification is sent.
ADMIN_NOTIFICATION_EMAIL="your-team-inbox@example.com"

# Daily privacy-retention batch (04:00 KST). "true" = only log how many rows
# each job would delete/scrub, change nothing. Turn on for the first production
# run, check the logs, then remove it.
RETENTION_DRY_RUN="false"

# Comma-separated retention jobs to skip (logged as "disabled"). Names:
#   survey-purge, unverified-accounts, withdrawn-emails, answered-inquiries,
#   admin-log-scrub, restriction-scrub
# survey-purge stays off until results keep a confirmed aggregate snapshot
# (spec 7.4) — purging raw answers before that empties the result charts.
RETENTION_DISABLED_JOBS="survey-purge"
