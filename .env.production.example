# docker-compose.prod.yml 전용 템플릿. 실제 값을 채운 사본을 레포 루트에
# ".env"로 저장해서 쓴다(.env는 .gitignore로 커밋 제외됨).
#
# DATABASE_URL의 호스트는 "postgres" 고정 — 컨테이너 간 통신은 서비스 이름으로
# 하므로 localhost가 아니다. 아래 POSTGRES_* 값과 반드시 일치시킬 것(docker-
# compose.prod.yml처럼 .env는 변수 치환을 지원하지 않아 직접 맞춰 적어야 한다).
DATABASE_URL="postgresql://uniform:change-me-to-a-strong-password@postgres:5432/uniform_prod?schema=public"

# postgres 서비스(공식 postgres 이미지)가 그대로 읽는 값 — 위 DATABASE_URL과 일치시킬 것.
POSTGRES_USER="uniform"
POSTGRES_PASSWORD="change-me-to-a-strong-password"
POSTGRES_DB="uniform_prod"

# App
PORT=3000

# Comma-separated allowed origins for CORS (e.g. frontend origin). Leave unset
# to allow all origins — for production, set this to the real frontend domain.
CORS_ORIGIN="https://your-frontend-domain.example"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
# Access token TTL. 30m for dev/test convenience; tighten before production deploy.
JWT_EXPIRES_IN="30m"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-string"
JWT_REFRESH_EXPIRES_IN="7d"

# Email verification token TTL
EMAIL_VERIFICATION_TOKEN_EXPIRES_IN="24h"

# Password reset token TTL
PASSWORD_RESET_TOKEN_EXPIRES_IN="30m"
